# PostgreSQL Connection (Supabase)
PGHOST=your-project.supabase.co
PGUSER=postgres
PGDATABASE=postgres
PGPASSWORD=your-password
PGPORT=5432
PGSSL=true
PGPOOL_MAX=10
PG_CONNECTION_TIMEOUT_MS=10000
PG_IDLE_TIMEOUT_MS=30000
PG_STATEMENT_TIMEOUT_MS=30000

# JWT Secret
JWT_SECRET=your-super-secret-jwt-key-change-in-production
JWT_EXPIRY=7d

# Server
PORT=3001
NODE_ENV=development

# CORS
CORS_ORIGIN=http://localhost:3000,http://localhost:5173,https://thithpt-website.web.app

# Email delivery
# Configure these on Render to send the welcome email after successful registration.
APP_URL=https://thithpt-website.web.app
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=your-email@gmail.com
SMTP_PASS=your-app-password
MAIL_FROM="ThiTHPT <your-email@gmail.com>"

# Upload storage
# Mode: supabase (recommended for production), local (development only), auto
UPLOAD_STORAGE=supabase
SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key
SUPABASE_STORAGE_BUCKET=exam-files
